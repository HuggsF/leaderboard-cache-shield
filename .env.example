# ── Application ──────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# TCP accept queue (clamped by net.core.somaxconn). Large on purpose: a stampede opens
# thousands of connections within a second.
HTTP_BACKLOG=4096
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = human readable logs (pino-pretty, dev only)
LOG_PRETTY=false
# Per-request access logs (off: at 10k req/s they cost more than the handler itself)
LOG_REQUESTS=false
# Hard deadline for graceful shutdown (SIGTERM/SIGINT)
SHUTDOWN_TIMEOUT_MS=30000

# ── MySQL 8 — required ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=leaderboard
DB_POOL_MIN=0
# Hard cap on concurrent queries from this instance
DB_POOL_MAX=10
# A query waiting longer than this for a pool connection fails (KnexTimeoutError)
DB_ACQUIRE_TIMEOUT_MS=10000
# Run pending migrations when the HTTP server starts
DB_MIGRATE_ON_START=false

# ── Redis 7 — required ───────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Leaderboard ──────────────────────────────────────────────
LEADERBOARD_PAGE_SIZE=50
# Artificial cost added to the ranking query with SLEEP() (SPEC: ~500 ms). 0 in tests.
LEADERBOARD_QUERY_DELAY_MS=500

# ── Cache (SPEC: 300 s fresh, 600 s total lifetime) ──────────
CACHE_FRESH_TTL_SECONDS=300
# Total lifetime: the entry is stale between the two TTLs, then disappears
CACHE_STALE_TTL_SECONDS=600

# ── Distributed lock (Redlock) ───────────────────────────────
# Lock lease; must exceed the slowest expected ranking query
LOCK_TTL_MS=10000
# Redlock retries when the lock is taken (SPEC: 3 retries, 200 ms apart, +/- jitter)
LOCK_RETRY_COUNT=3
LOCK_RETRY_DELAY_MS=200
LOCK_RETRY_JITTER_MS=50
# How long a request waits for another request's rebuild before falling back (stale or 503)
LOCK_WAIT_TIMEOUT_MS=5000
# How often a waiting request checks whether the entry became fresh
LOCK_POLL_INTERVAL_MS=50

# ── docker-compose host ports (change if 3306/6379/3000 are taken) ──
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
APP_HOST_PORT=3000
