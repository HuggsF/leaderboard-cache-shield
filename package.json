{
  "name": "leaderboard-cache-shield",
  "version": "1.0.0",
  "description": "Cache Stampede prevention for a 10,000-concurrent-users leaderboard: naive TTL vs Redis distributed lock (Redlock) vs stale-while-revalidate, measured under load.",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/presentation/cli/main.ts migrate",
    "migrate:rollback": "tsx src/presentation/cli/main.ts migrate --rollback",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "tsx load-tests/run-stampede.ts",
    "loadtest:naive": "npx --yes artillery@2.0.34 run load-tests/stampede-naive.yml",
    "loadtest:lock": "npx --yes artillery@2.0.34 run load-tests/stampede-lock.yml",
    "loadtest:swr": "npx --yes artillery@2.0.34 run load-tests/stampede-swr.yml",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ scripts/ load-tests/ --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts,load-tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,scripts,load-tests}/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:seed": "docker-compose --profile tools run --rm tools npm run seed",
    "docker:loadtest": "docker-compose --profile tools run --rm tools npm run loadtest"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "pino": "^9.14.0",
    "redlock": "5.0.0-beta.2",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "rimraf": "^5.0.10",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
